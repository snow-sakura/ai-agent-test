# AITest Hub 后端本地配置样例
# 复制为 backend/.env 后按需修改（.env 已被 .gitignore 忽略，切勿提交真实值）
#   cp .env.example .env

# ---- 种子账号（首次启动建库时写入，之后改动需手动更新 users 表）----
# 演示账号：登录页「一键填充」通过 GET /api/config/demo-account 读取它
DEMO_ACCOUNT=13800000000
DEMO_PASSWORD=Demo@2026
# 平台管理员口令（默认 admin123，对外部署务必改）
ADMIN_PASSWORD=admin123
# 置 0 关闭演示账号下发接口（登录页将不再显示「一键填充」）
DEMO_ACCOUNT_PUBLIC=1

# ---- 安全 ----
# 生产必须换成随机值：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ---- 可选：AI 默认接入（页面内配置中心的优先级更高）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
